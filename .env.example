# Copy to .env (never commit it) and fill in what you use. docker compose reads it automatically.

# Access token for the GUI. Required if you publish the port on anything other than loopback.
# DIGEST_GUI_TOKEN=
# Extra Host names the GUI answers to, comma separated (e.g. the server's LAN address)
# DIGEST_ALLOWED_HOSTS=

# Microsoft Graph (Teams, Outlook)
# DIGEST_GRAPH_CLIENT_ID=
# DIGEST_GRAPH_TENANT=

# Connectors
# NOTION_TOKEN=
# SLACK_TOKEN=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
